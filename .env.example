# Pegue TG_API_ID e TG_API_HASH em https://my.telegram.org
TG_API_ID=COLE_SEU_API_ID
TG_API_HASH=COLE_SEU_API_HASH

# Pegue o token do bot Telegram com @BotFather (comando /newbot)
TG_BOT_TOKEN=COLE_O_TOKEN_DO_BOT

# Sessão autorizada da conta pessoal, gerada uma vez com generate_session.py
TG_USER_SESSION=COLE_A_SESSAO_GERADA

# IDs de outros usuarios que podem gerenciar filtros/canais e receber alertas
# A conta da sessao permanece autorizada automaticamente
TG_ALLOWED_USER_IDS=[]

# No Compose o host é mysql. Para MySQL externo, use o endereço do servidor.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=telegram_ofertas
MYSQL_USER=telegram_ofertas
MYSQL_PASSWORD=COLE_UMA_SENHA_FORTE
# Usada apenas para criar o servidor MySQL do Compose
MYSQL_ROOT_PASSWORD=COLE_OUTRA_SENHA_FORTE

# Opcional: cadastrar frases e canais automaticamente (arrays JSON)
INITIAL_KEYWORDS=[]
INITIAL_CHAT_IDS=[]

# Tamanho maximo de midia para replicar no alerta (em MB)
MAX_MEDIA_MB=15

# Anuncios semelhantes capturados dentro dessa janela (em segundos) viram um
# alerta so, com o menor preco em R$. Use 0 para enviar tudo na hora.
DEDUP_WINDOW_SECONDS=5

# Semelhanca minima (0 a 1) para dois textos virarem o mesmo anuncio.
# Valores maiores exigem textos mais parecidos e repetem mais; teste com /similar.
DEDUP_SIMILARITY=0.65

# Acrescentar "Fonte: nome do grupo" no inicio de cada alerta (1 ou 0)
SHOW_SOURCE=1
